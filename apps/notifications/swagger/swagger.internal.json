{
  "openapi": "3.0.0",
  "paths": {
    "/internal/v1/jobs/notification": {
      "post": {
        "operationId": "createNotification",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationJobDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Creates a notification job"
          }
        },
        "tags": [
          "Jobs"
        ]
      }
    },
    "/internal/v1/users/{userId}/purge": {
      "post": {
        "operationId": "purge",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-organization-id",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "tags": [
          "Internal/Account"
        ]
      }
    },
    "/internal/v1/address-confirmations": {
      "post": {
        "operationId": "confirmAddress",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressConfirmationInput"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Confirms the address a confirmation link was emailed to, which then receives its channel's alerts"
          },
          "400": {
            "description": "Validation error responded when some request parameters are invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized error responded when the user is not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden error responded when the user is not authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error, should probably be reported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerErrorResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Internal/AddressConfirmation"
        ]
      }
    },
    "/internal/v1/organizations/{organizationId}/departed-members": {
      "post": {
        "operationId": "releaseDepartedMember",
        "parameters": [
          {
            "name": "organizationId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepartedMemberInput"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Stops the organization's notification channels from emailing a member who left it"
          }
        },
        "tags": [
          "Internal/Organization"
        ]
      }
    },
    "/internal/v1/organizations/{organizationId}/purge": {
      "post": {
        "operationId": "purgeOrganization",
        "parameters": [
          {
            "name": "organizationId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deletes a deleted organization's alerts and notification channels"
          }
        },
        "tags": [
          "Internal/Organization"
        ]
      }
    },
    "/internal/v1/organizations/{organizationId}/deployment-alerts/{dseq}/project": {
      "put": {
        "operationId": "moveDeploymentAlertsToProject",
        "parameters": [
          {
            "name": "organizationId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dseq",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeploymentAlertsProjectInput"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Files the alerts of a deployment into the project the deployment moved to"
          }
        },
        "tags": [
          "Internal/DeploymentAlert"
        ]
      }
    }
  },
  "info": {
    "title": "NotificationsAPI (Internal)",
    "description": "Internal-only endpoints for server-to-server use within the private network. Not exposed to the public internet.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "minimum": 400,
            "maximum": 400
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "properties": {
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {}
                }
              }
            },
            "required": [
              "issues"
            ]
          }
        },
        "required": [
          "statusCode",
          "message",
          "errors"
        ]
      },
      "UnauthorizedErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "minimum": 401,
            "maximum": 401
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "ForbiddenErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "minimum": 403,
            "maximum": 403
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "InternalServerErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "minimum": 500,
            "maximum": 500
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "NotificationJobDto": {
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "string"
          },
          "notificationChannelId": {
            "type": "string"
          },
          "startAfter": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "label",
                    "url"
                  ]
                }
              }
            },
            "required": [
              "summary",
              "description"
            ]
          },
          "unsubscribe": {
            "description": "Marks the email as promotional: it gets an unsubscribe footer, the postal address and one-click unsubscribe headers",
            "type": "object",
            "properties": {
              "url": {
                "description": "https URL of the unsubscribe page linked from the email footer",
                "type": "string",
                "format": "uri",
                "pattern": "^[\\x21-\\x7e]+$"
              },
              "oneClickUrl": {
                "description": "https URL of the endpoint that takes the RFC 8058 one-click unsubscribe POST",
                "type": "string",
                "format": "uri",
                "pattern": "^[\\x21-\\x7e]+$"
              }
            },
            "required": [
              "url",
              "oneClickUrl"
            ]
          },
          "recipient": {
            "description": "Sends the email to this address alone in place of the channel's addresses",
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "notificationId",
          "payload"
        ]
      },
      "AddressConfirmationInput": {
        "type": "object",
        "properties": {
          "token": {
            "description": "The token of the confirmation link emailed to the address",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "DepartedMemberInput": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "addressSha256": {
                "description": "SHA-256 hex digest of the departed member's lower-cased email address",
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "fallbackAddresses": {
                "description": "Where a channel goes once the departed member's address was its only one; without any, such a channel is deleted",
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "email"
                }
              }
            },
            "required": [
              "addressSha256",
              "fallbackAddresses"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "DeploymentAlertsProjectInput": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "projectId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "owner",
              "projectId"
            ]
          }
        },
        "required": [
          "data"
        ]
      }
    }
  }
}