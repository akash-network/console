{
  "extends": "./tsconfig.build.json",
  // Vitest and tsup load these files as ESM, so `import.meta` and top-level await are legal here even though the build emits CommonJS.
  "compilerOptions": {
    "target": "es2022",
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["esnext"],
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
