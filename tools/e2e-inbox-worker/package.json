{
  "name": "e2e-inbox-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Email Worker that captures e2e OTP emails (e2e.akash.network) into D1 and serves them over a token-protected HTTP endpoint",
  "scripts": {
    "db:apply": "wrangler d1 execute console-e2e-inbox --remote --file=./schema.sql",
    "db:apply:local": "wrangler d1 execute console-e2e-inbox --local --file=./schema.sql",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postal-mime": "^2.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.0",
    "wrangler": "^4.20.0"
  }
}
